{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@chatool/utils": ["../../packages/utils/src/index.ts"],
      "@chatool/utils/hooks": ["../../packages/utils/src/hooks/index.ts"],
      "@chatool/core": ["../../packages/core/src/index.ts"],
      "@chatool/ui/button": ["../../packages/ui/src/buttons/button/index.tsx"],
      "@chatool/ui/icon-button": [
        "../../packages/ui/src/buttons/icon-button/index.tsx"
      ],
      "@chatool/ui/button-group": [
        "../../packages/ui/src/buttons/button-group/index.tsx"
      ],
      "@chatool/ui/fab": ["../../packages/ui/src/buttons/fab/index.tsx"],
      "@chatool/ui/loading-indicator": [
        "../../packages/ui/src/loading/loading-indicator/index.tsx"
      ],
      "@chatool/ui/linear-progress": [
        "../../packages/ui/src/loading/linear-progress/index.tsx"
      ],
      "@chatool/ui/circular-progress": [
        "../../packages/ui/src/loading/circular-progress/index.tsx"
      ],
      "@chatool/ui/divider": [
        "../../packages/ui/src/dividers/divider/index.tsx"
      ],
      "@chatool/ui/badge": ["../../packages/ui/src/badges/badge/index.tsx"],
      "@chatool/ui/checkbox": [
        "../../packages/ui/src/selection/checkbox/index.tsx"
      ],
      "@chatool/ui/radio": ["../../packages/ui/src/selection/radio/index.tsx"],
      "@chatool/ui/radio-group": [
        "../../packages/ui/src/selection/radio-group/index.tsx"
      ],
      "@chatool/ui/switch": [
        "../../packages/ui/src/selection/switch/index.tsx"
      ],
      "@chatool/ui/slider": ["../../packages/ui/src/sliders/slider/index.tsx"],
      "@chatool/ui/card": ["../../packages/ui/src/cards/card/index.tsx"],
      "@chatool/ui/tooltip": [
        "../../packages/ui/src/overlays/tooltip/index.tsx"
      ],
      "@chatool/ui/text-field": [
        "../../packages/ui/src/text-fields/text-field/index.tsx"
      ],
      "@chatool/ui/chip": ["../../packages/ui/src/chips/chip/index.tsx"],
      "@chatool/ui/chip-set": [
        "../../packages/ui/src/chips/chip-set/index.tsx"
      ],
      "@chatool/ui/tabs": ["../../packages/ui/src/tabs/tabs/index.tsx"],
      "@chatool/icons/*": ["../../packages/icons/src/*.tsx"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
